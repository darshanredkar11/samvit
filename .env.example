# Copy to .env and fill in values before running in production.
# For local dev the defaults in docker-compose.yml are sufficient.

POSTGRES_USER=samvit
POSTGRES_PASSWORD=changeme
POSTGRES_DB=samvit

REDPANDA_BROKERS=redpanda:9092

# Required for admin token reset (POST /v1/admin/agents/{handle}/reset)
SAMVIT_ADMIN_SECRET=changeme

# Set to true to skip auth on the admin dashboard (local dev only).
SAMVIT_ADMIN_DEV_MODE=false

LOG_LEVEL=INFO

# Ethical guard mode: redact (default) | block | warn | off
SAMVIT_GUARD_MODE=redact

# Bind only to localhost by default. Set 0.0.0.0 only behind a firewall,
# private network, VPN, or TLS reverse proxy.
SAMVIT_BIND_ADDRESS=127.0.0.1

# Local repository mounted read-only at /workspace for index_code.
SAMVIT_WORKSPACE=.

# Comma-separated browser origins allowed to call Samvit.
SAMVIT_CORS_ORIGINS=http://localhost,http://127.0.0.1
